{
  "name": "dollarbaan-plus",
  "version": "1.0.0",
  "description": "DollarBaan Plus: self-hosted and offline personal finance dashboard for Iranian assets (currency, gold, coin, crypto, Tehran stocks, cash) in Toman. An enhanced fork of DollarBaan by MahdiGraph",
  "keywords": [
    "personal-finance",
    "portfolio-tracker",
    "iran",
    "toman",
    "gold",
    "currency",
    "cryptocurrency",
    "persian",
    "farsi",
    "rtl",
    "jalali",
    "self-hosted",
    "electron",
    "android",
    "dashboard",
    "stocks",
    "tehran-stock-exchange",
    "tse",
    "bourse",
    "profit-and-loss",
    "multi-profile",
    "dollarbaan",
    "fork"
  ],
  "homepage": "https://github.com/farshad-zamani/DollarBaan-Plus#readme",
  "bugs": {
    "url": "https://github.com/farshad-zamani/DollarBaan-Plus/issues"
  },
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "version:sync": "node scripts/sync-version.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farshad-zamani/DollarBaan-Plus.git"
  },
  "author": "DollarBaan Plus contributors (fork of DollarBaan by MahdiGraph)",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  },
  "overrides": {
    "node-gyp": "^11.5.0",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
